spawn-sh-at-startup "nice -n -5 noctalia-shell"
spawn-sh-at-startup "wpctl set-mute @DEFAULT_AUDIO_SINK@ 1" // Mute Sink
spawn-sh-at-startup "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1" // Mute Source

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// --- Output (Monitor) Configuration ---
//
output "Iiyama North America PL2783Q 1151265001263" {
    focus-at-startup
    variable-refresh-rate on-demand=true
    // position x=1920 y=0
}

output "eDP-1" {
    position x=0 y=0
    scale 2.0
}

// Example for your RTK monitor (using its description logic)
output "Invalid Vendor Codename - RTK HG560T34 0x10101010" {
    mode "3840x2400"
    position x=0 y=0
    scale 2
    transform "180"
}


window-rule {
    match app-id="blueman-manager"
    match app-id="nm-connection-editor"
    match app-id="com.saivert.pwvucontrol"
    match title="Syncthing"
    open-floating true
}

// Privacy mode
window-rule {
    match title="Bitwarden"
    match title="sops"
    match title="Picture-in-Picture"

    block-out-from "screen-capture"
}

// Bitwarden
window-rule {
    match title="Bitwarden"
    default-column-width { proportion 0.33;}
    max-width 500
}


layer-rule {
  match namespace="^noctalia-overview*"
  place-within-backdrop true
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
  // strict-new-window-focus-policy
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

layout {
    center-focused-column "never"
}

/* Noctalia: blur everywhere without xray for a better look */
layer-rule {
  match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  background-effect {
    blur true
    xray false
  }
}

blur {
  passes 2        // more passes = stronger blur (default: 3)
  offset 3.0      // sample distance per pass (default: 3.0)
  noise 0.03      // grain overlay (default: 0.02)
  saturation 1.0  // color saturation boost (default: 1.5)
}
